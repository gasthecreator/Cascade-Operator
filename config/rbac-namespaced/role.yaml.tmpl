# Template for hack/generate-namespaced-rbac.sh — its own namespace
# placeholder token (see that script) gets substituted with each real
# target namespace below. Rules here are the exact
# same rule set as config/rbac/role.yaml's cluster-scoped manager-role
# ClusterRole (every one of its rules is over a namespaced resource type —
# CascadePolicy + subresources, Linkerd ServiceProfile, Istio
# DestinationRule/VirtualService, and Service — confirmed by reading that
# file directly, not assumed), just expressed as a Role bound to one
# namespace instead of a ClusterRole bound cluster-wide. This is the
# concrete implementation of docs/security-threat-model.md's own
# production-hardening step: "Narrowing it to a Role+RoleBinding per
# watched namespace."
#
# Not regenerated by controller-gen (unlike config/rbac/role.yaml) — if
# the reconciler's own RBAC markers
# (internal/controller/cascadepolicy_controller.go's
# +kubebuilder:rbac comments) ever change, update this template to match,
# same as any other manually-maintained mirror of a generated file.
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  labels:
    app.kubernetes.io/name: cascade-operator
    app.kubernetes.io/managed-by: kustomize
  name: cascade-operator-manager-role
  namespace: __NAMESPACE__
rules:
- apiGroups:
  - ""
  resources:
  - services
  verbs:
  - get
  - list
  - patch
  - update
  - watch
- apiGroups:
  - cascade.gideonsanni.dev
  resources:
  - cascadepolicies
  verbs:
  - create
  - delete
  - get
  - list
  - patch
  - update
  - watch
- apiGroups:
  - cascade.gideonsanni.dev
  resources:
  - cascadepolicies/finalizers
  verbs:
  - update
- apiGroups:
  - cascade.gideonsanni.dev
  resources:
  - cascadepolicies/status
  verbs:
  - get
  - patch
  - update
- apiGroups:
  - linkerd.io
  resources:
  - serviceprofiles
  verbs:
  - get
  - list
  - patch
  - update
  - watch
- apiGroups:
  - networking.istio.io
  resources:
  - destinationrules
  - virtualservices
  verbs:
  - get
  - list
  - patch
  - update
  - watch
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  labels:
    app.kubernetes.io/name: cascade-operator
    app.kubernetes.io/managed-by: kustomize
  name: cascade-operator-manager-rolebinding
  namespace: __NAMESPACE__
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: cascade-operator-manager-role
subjects:
- kind: ServiceAccount
  name: cascade-operator-controller-manager
  namespace: cascade-operator-system
